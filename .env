# App
APP_ENV=development
LOG_LEVEL=INFO

# Sarvam AI (STT)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v3
SARVAM_WS_URL=wss://api.sarvam.ai/speech-to-text/ws

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_GENERATION_MODEL=llama-3.1-8b-instant
GROQ_JUDGE_MODEL=llama-3.1-8b-instant

# Qdrant Cloud
QDRANT_URL=https://your-cluster-id.aws.ap-south-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=voice_rag_msmarco_xi
QDRANT_USE_GRPC=true

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_ONNX_PATH=./data/models/bge-m3-int8.onnx
EMBEDDING_DIM=1024

# Guardrail Thresholds
HYBRID_ABSTAIN_THRESHOLD=0.55
SAFETY_REGEX_ENABLED=true

# Latency Budgets
SLA_RETRIEVAL_CORE_MS=200
SLA_TTFT_MS=500